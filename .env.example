# Copy this to .env and fill in your values

# Optional: only needed for AI-powered Recovery Plan narratives
ANTHROPIC_API_KEY=sk-ant-...

# SQLite database path (relative to project root)
DATABASE_URL=sqlite:///./data/tradein_sight.db

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Behavior detection thresholds (override defaults)
AVG_DOWN_THRESHOLD=2          # min number of adds to flag as averaging down
NEAR_EXPIRY_DTE=7             # days-to-expiry threshold for near-expiry flag
OVERSIZE_PCT=10               # position size % of account to flag as oversized
FOMO_MOVE_PCT=5               # underlying move % before entry to flag as FOMO
MAX_ACCOUNT_SIZE=100000       # used for position sizing calculations
